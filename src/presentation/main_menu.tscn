[node name="RulesText" type="Label" parent="RulesModal/ContentBox/RulesScroll"]
custom_minimum_size = Vector2(530, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 12
text = "OBJECTIVE:
Be the first player to shed all cards from your Hand (Group A), Face-Up Table (Group B), and Face-Down Table (Group C).

THE THREE CARD LAYERS:
• Group A (Hand, 4 cards): Private cards only you can see.
• Group B (Face-Up, 4 cards): Public table cards. Can only be played once your Hand is completely empty.
• Group C (Face-Down, 4 cards): Blind hidden cards. Can only be flipped blind once Group A and Group B are empty!

STRATEGY SWAP PHASE (30 Seconds):
At the start, you have 30 seconds to swap cards between your Hand (A) and Face-Up Table (B). Place powerful cards (Aces, 2s, 10s) face-up to make the endgame easier!

RULES OF PLAY:
1. Play cards of equal or higher rank than the current ground pile.
2. If multiple cards of the same rank are in your hand, you can play them together!
3. If you have no valid card to play, you MUST pick up the entire ground pile!

SPECIAL CARDS:
• Rank 2: Can be played on ANY card. Resets the ground pile requirement back to 2!
• Rank 10: Burns the ground pile immediately to the graveyard! You get another turn.
• 4-of-a-Kind: Playing or completing four cards of the exact same rank burns the ground pile and awards an extra turn!"
autowrap_mode = 2

